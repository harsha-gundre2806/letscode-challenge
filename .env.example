# Copy this file to .env and insert your authentic API keys if desired.
# All authentic public APIs (Open-Meteo, Copernicus, Nominatim, Web Speech) 
# operate freely and authentically out of the box with zero keys required.

VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_WAQI_API_KEY=your_waqi_token_here
VITE_OPENWEATHER_API_KEY=your_openweather_key_here
