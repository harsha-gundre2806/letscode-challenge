# ====================================================================
# BreatheBetter: Real-Time Air Quality Intelligence Platform (.env)
# ====================================================================

# 1. Google Gemini API Key (Optional)
# Enables cloud LLM synthesis in the BreatheAI Environmental Assistant.
# If omitted, the platform uses its high-fidelity built-in domain intelligence engine.
VITE_GEMINI_API_KEY=

# 2. WAQI (World Air Quality Index) Station Token (Optional)
# Enables direct ground-station cross-validation tokens.
VITE_WAQI_API_KEY=

# 3. OpenWeatherMap Air Pollution Key (Optional)
VITE_OPENWEATHER_API_KEY=
